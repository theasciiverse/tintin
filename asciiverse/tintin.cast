[0.002, "o", "\r\u001b[30;1H\u001b[?1000l\u001b[?1002l\u001b[?1006l\u001b[?1016l\u001b[?1004h\u001b=\u001b[>4;1m\u001b[?1049l\u001b[?7787l\u001b[r\r\u001b[30;1H\u001b[0m\u001b[0m\r\n"]
[0.001, "o", "\u001b[?25l\u001b[0m                  \u001b[1;33mNew Worlds Ateraan \u001b[1;37m- \u001b[1;33m\u001b]8;;http://www.ateraan.com\u0007\u001b[04mhttp://www.ateraan.com\u001b[24m\u001b]8;;\u0007                   \u001b[0m\r\n\u001b[0m\r\u001b[30;1H\u001b[?25h\u001b[0m\u001b[0m\r\n"]
[0.000, "o", "\u001b[?25l\u001b[0m\u001b[22;37mAteraan is a world of Intensive Roleplaying offering many unique and powerful   \u001b[0m\r\n"]
[0.000, "o", "\u001b[0m\u001b[0;37mguilds, races, politics, religion, justice, economy, and a storyline that is    \u001b[0m\r\n"]
[0.000, "o", "\u001b[0m\u001b[0;37mdominantly player controlled and based on a novel. The game is based on a       \u001b[0m\r\n"]
[0.000, "o", "\u001b[0m\u001b[0;37mKingdom with knights, merchants, mages, and thieves, and a fierce southern      \u001b[0m\r\n\u001b[0m\u001b[0;37mstate that has warriors, shaman, slaves, and servants. Ships rule the seas and  \u001b[0m\r\n"]
[0.000, "o", "\u001b[0m\u001b[0;37mcaravans travel the lands. With 100's of players and features like invasions,   \u001b[0m\r\n\u001b[0m\u001b[0;37mship creation, house building, clans, theaters, leatherball fields, and massive \u001b[0m\r\n"]
[0.000, "o", "\u001b[0m\u001b[0;37mevents, the game is incredibly robust and diverse.                              \u001b[0m\r\n"]
[0.000, "o", "\u001b[0m\r\u001b[30;1H\u001b[?25h\u001b[0m\u001b[0m\r\n"]
[0.000, "o", "\u001b[?25l\u001b[0m\u001b[1;37mTo connect to New Worlds Ateraan enter: #session nwa ateraan.com 4002           \u001b[0m\r\n\u001b[0m\r\u001b[30;1H\u001b[?25h\u001b[0m\u001b[0m\r\n"]
